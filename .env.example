# Deployment environment: development (default) | staging | production.
# Setting this to "production" auto-corrects/flags a few known-unsafe
# local-dev defaults at startup (SESSION_COOKIE_SECURE, ALLOWED_ORIGINS,
# GITHUB_WEBHOOK_SECRET) — see Settings.validate_production_safety in
# app/config.py.
APP_ENV=development

# GitHub App
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# Set ONLY during a webhook-secret rotation, to the OUTGOING secret — lets
# deliveries signed with either the old or new secret verify during the
# rotation window. Unset again once rotation is confirmed complete. See
# docs/SECRET_ROTATION.md.
GITHUB_WEBHOOK_SECRET_PREVIOUS=

# GitHub OAuth App ("Sign in with GitHub") — separate from the App above.
# Create at https://github.com/settings/developers, or enable
# "Request user authorization (OAuth) during installation" on the GitHub
# App itself and reuse its Client ID/Secret. Callback URL must be
# {BACKEND_BASE_URL}/auth/github/callback.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Session cookies issued after OAuth login
SESSION_COOKIE_NAME=ignition_session
SESSION_TTL_SECONDS=604800
SESSION_COOKIE_SECURE=false

# CSRF double-submit cookie, issued alongside the session cookie above.
# Only needs to change from the default if it collides with something else
# on the same domain — the frontend reads this exact name back
# (frontend/src/lib/api-client.ts), so if you change it here, change it
# there too.
CSRF_COOKIE_NAME=ignition_csrf_token
CSRF_HEADER_NAME=X-CSRF-Token

# Prometheus scrape target at GET /metrics — unauthenticated, like /healthz.
# Set false to omit the endpoint entirely on a deployment that doesn't want
# operational metrics exposed.
METRICS_ENABLED=true

# Used to build the OAuth redirect_uri and post-login redirect
BACKEND_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000

# LLM provider — Groq (OpenAI-compatible), free tier by default
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL_NAME=qwen/qwen3-32b

# Supabase / pgvector
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# AST analyzer (persistent Bun service)
AST_SERVICE_URL=http://localhost:4000

# Graph behavior bounds — deterministic, not tuned at runtime
HALLUCINATION_RETRY_CAP=3
REVIEW_LATENCY_BUDGET_SECONDS=60

# Rate limiting (slowapi/limits). memory:// is per-process — fine for the
# default single `backend` replica topology (docker-compose.yml). Point at
# a real redis:// URL once backend replicas > 1 so limits are enforced
# consistently across instances.
RATE_LIMIT_STORAGE_URI=memory://
DEFAULT_RATE_LIMIT=300/minute
WEBHOOK_RATE_LIMIT=120/minute
AUTH_RATE_LIMIT=20/minute

# AST analyzer's per-repo warm ts-morph Project cache — bounded LRU, evicts
# the least-recently-used repo once this many distinct repos are cached.
AST_CACHE_MAX_PROJECTS=25

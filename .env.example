# Deployment environment: development (default) | staging | production.
# Setting this to "production" auto-corrects/flags a few known-unsafe
# local-dev defaults at startup (SESSION_COOKIE_SECURE, ALLOWED_ORIGINS,
# GITHUB_WEBHOOK_SECRET) — see Settings.validate_production_safety in
# app/config.py.
APP_ENV=development

# GitHub App
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# Optional: the App's URL slug (github.com/apps/<slug>). Ignition edits only
# its own "<slug>[bot]" review comment (one sticky comment per PR). Blank =
# looked up once from GitHub at runtime.
GITHUB_APP_SLUG=
# Set ONLY during a webhook-secret rotation, to the OUTGOING secret — lets
# deliveries signed with either the old or new secret verify during the
# rotation window. Unset again once rotation is confirmed complete. See
# docs/SECRET_ROTATION.md.
GITHUB_WEBHOOK_SECRET_PREVIOUS=

# Dashboard login ("Sign in with GitHub") uses the GitHub App's own OAuth
# flow (audit P1-1): its Client ID and a client secret from the App's
# settings page. Callback URL must be {BACKEND_BASE_URL}/auth/github/callback.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Fernet key(s) that encrypt users' GitHub tokens at rest. Generate one with
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# To rotate: NEW_KEY,OLD_KEY (the first encrypts, all decrypt).
SESSION_TOKEN_KEYS=

# Session cookies issued after OAuth login
SESSION_COOKIE_NAME=ignition_session
SESSION_TTL_SECONDS=604800
SESSION_COOKIE_SECURE=false
# lax: the browser only talks to the frontend's origin, which proxies /api
# and /auth here through Next.js rewrites (frontend/next.config.ts, audit
# P0-5), so the session cookie is first-party. "none" is only for a
# deployment that bypasses the rewrites and calls this API cross-site.
SESSION_COOKIE_SAMESITE=lax

# CSRF double-submit cookie, issued alongside the session cookie above.
# Only needs to change from the default if it collides with something else
# on the same domain — the frontend reads this exact name back
# (frontend/src/lib/api-client.ts), so if you change it here, change it
# there too.
CSRF_COOKIE_NAME=ignition_csrf_token
CSRF_HEADER_NAME=X-CSRF-Token

# Prometheus scrape target at GET /metrics, behind
# Authorization: Bearer $METRICS_TOKEN (I-11). Blank token: open in
# development, 404 when APP_ENV=production. METRICS_ENABLED=false omits it.
METRICS_ENABLED=true
METRICS_TOKEN=
# Bearer token for GET /readyz, the deep dependency check (I-5). Blank:
# /readyz is open in development and 404 when APP_ENV=production.
READYZ_TOKEN=

# BACKEND_BASE_URL is this API's PUBLIC origin, i.e. the frontend that
# proxies it (audit P0-5). The OAuth redirect_uri is built from it, so the
# session cookie is set on the frontend's origin. FRONTEND_BASE_URL is
# where the browser goes after login.
BACKEND_BASE_URL=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:3000

# LLM provider — Groq (OpenAI-compatible), free tier by default
LLM_PROVIDER=groq
LLM_API_KEY=
# qwen/qwen3-32b was shut down by Groq on 2026-07-17 — every call to it errors.
LLM_MODEL_NAME=openai/gpt-oss-120b
# gpt-oss: low|medium|high. qwen3.x: none|default. Blank = omit the parameter.
LLM_REASONING_EFFORT=low

# Supabase / pgvector
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# AST analyzer (persistent Bun service)
AST_SERVICE_URL=http://localhost:4000

# Graph behavior bounds — deterministic, not tuned at runtime
HALLUCINATION_RETRY_CAP=3
REVIEW_LATENCY_BUDGET_SECONDS=60

# Rate limiting (slowapi/limits). memory:// is per-process — fine for the
# default single `backend` replica topology (docker-compose.yml). Point at
# a real redis:// URL once backend replicas > 1 so limits are enforced
# consistently across instances.
RATE_LIMIT_STORAGE_URI=memory://
DEFAULT_RATE_LIMIT=300/minute
WEBHOOK_RATE_LIMIT=120/minute
AUTH_RATE_LIMIT=20/minute

# AST analyzer's per-repo warm ts-morph Project cache — bounded LRU, evicts
# the least-recently-used repo once this many distinct repos are cached.
AST_CACHE_MAX_PROJECTS=25

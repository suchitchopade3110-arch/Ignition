# Same-origin API (audit P0-5): the dashboard calls its own /api and /auth
# paths, and frontend/next.config.ts rewrites them to the backend.
# NEXT_PUBLIC_* are inlined at `next build`; BACKEND_INTERNAL_URL is read
# when the rewrites are built, so set all three before building.
NEXT_PUBLIC_API_URL=/api
# Empty = same origin (the login link becomes /auth/github/login).
NEXT_PUBLIC_BACKEND_URL=
# Where /api and /auth are proxied to. Required for a production build.
BACKEND_INTERNAL_URL=http://localhost:8000
# Mock data instead of a backend, for UI work only. Never in production.
NEXT_PUBLIC_DEMO_MODE=false

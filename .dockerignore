# Defense in depth: the Dockerfile currently only COPYs specific
# directories (app/, ast-analyzer/, docker-entrypoint.sh, requirements.txt)
# so .env was never actually reachable by a build — verified in
# docs/SECRET_ROTATION.md's audit. This file exists so that stays true even
# if the Dockerfile is ever changed to a blanket `COPY . .`.
.env
.env.*
!.env.example

.git/
node_modules/
__pycache__/
*.pyc
.pytest_cache/
workspaces/
ast-analyzer/workspaces/
scratch/
frontend/node_modules/
frontend/.next/
